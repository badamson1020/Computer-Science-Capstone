# Example environment configuration for the production database connection.
# Copy this file to .env and fill in your own values.
# .env is excluded from version control via .gitignore to prevent
# exposing real credentials.

MONGO_USER=your_username_here
MONGO_PASS=your_password_here
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=AAC
MONGO_COL=animals

# database used for authentication, matches MONGO_DB for a single db setup
MONGO_AUTH=AAC
# Example environment configuration for the test database connection.
# Copy this file to .env.test and fill in your own values.
# Tests run against a dedicated AAC_Test database to ensure
# the production AAC database is never modified during testing.
# .env.test is excluded from version control via .gitignore to prevent
# exposing real credentials.

MONGO_USER=your_username_here
MONGO_PASS=your_test_password_here
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=AAC_Test
MONGO_COL=animals

# database used for authentication, matches MONGO_DB for a single db setup
MONGO_AUTH=AAC_Test
